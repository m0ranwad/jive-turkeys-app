# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys.
# Leave the VITE_ values blank to run the app in demo mode (sample data kept in your browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only for `npm run import:base44` (not used at launch). Never prefix with VITE_ (that would publish it).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional reference copies kept only on your computer. The app never reads these:
# RESEND_API_KEY (Supabase SMTP password), GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
# (Supabase Google provider).
